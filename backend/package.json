{
  "name": "tanssitietokanta",
  "description": "Tanssitietokanta",
  "version": "0.0.0",
  "homepage": "",
  "private": true,
  "keywords": [
    "feathers"
  ],
  "author": {},
  "contributors": [],
  "bugs": {},
  "engines": {
    "node": ">= 18.14.0"
  },
  "feathers": {
    "language": "ts",
    "packager": "npm",
    "database": "other",
    "framework": "koa",
    "transports": [
      "rest",
      "websockets"
    ],
    "schema": "typebox"
  },
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "files": [
    "lib/client.js",
    "lib/**/*.d.ts",
    "lib/**/*.shared.js"
  ],
  "main": "lib/client",
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "create-user": "ts-node src/create-user.ts",
    "create-migration": "ts-node src/create-migration.ts",
    "dev": "cross-env CORS_ALLOW_LOCALHOST=true tsx watch --include \"src/**/*.graphql\" --clear-screen=false src/index.ts",
    "typecheck": "nodemon --watch src -e ts -x node_modules/typescript-7/bin/tsc --noEmit",
    "codegen": "graphql-codegen",
    "compile": "shx rm -rf lib/ && graphql-codegen && copyfiles -u 1 src/**/*.graphql lib && copyfiles -u 1 src/**/*.json lib && node_modules/typescript-7/bin/tsc -p tsconfig.build.json",
    "start": "node lib/",
    "start-dev": "cross-env CORS_ALLOW_LOCALHOST=true node lib/",
    "mocha": "cross-env NODE_ENV=test mocha --require ./test/hooks.ts test/ --recursive --watch",
    "mocha:once": "cross-env NODE_ENV=test mocha --require ./test/hooks.ts test/ --recursive",
    "test": "npm run mocha",
    "bundle:client": "npm run compile && npm pack --pack-destination ./public",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@apollo/server": "^5.5.0",
    "@feathersjs/adapter-commons": "5.0.49",
    "@feathersjs/authentication": "5.0.49",
    "@feathersjs/authentication-client": "5.0.49",
    "@feathersjs/authentication-local": "5.0.49",
    "@feathersjs/configuration": "5.0.49",
    "@feathersjs/errors": "5.0.49",
    "@feathersjs/feathers": "5.0.49",
    "@feathersjs/koa": "5.0.49",
    "@feathersjs/schema": "5.0.49",
    "@feathersjs/socketio": "5.0.49",
    "@feathersjs/transport-commons": "5.0.49",
    "@feathersjs/typebox": "5.0.49",
    "@graphql-tools/load-files": "^6.6.1",
    "@graphql-tools/merge": "^8.4.1",
    "@koa/cors": "^5.0.0",
    "@seald-io/nedb": "^4.1.2",
    "@types/archiver": "^8.0.0",
    "@types/cookie": "^1.0.0",
    "@types/jsdom": "^28.0.3",
    "archiver": "^8.0.0",
    "canvas": "^3.2.3",
    "clamscan": "^2.4.0",
    "colorette": "^2.0.20",
    "content-disposition-3": "npm:content-disposition@^3.0.0",
    "cookie": "^2.0.1",
    "es-toolkit": "^1.52.0",
    "fabric": "^7.4.0",
    "fast-json-patch": "^3.1.1",
    "feathers-hooks-common": "^8.2.1",
    "feathers-nedb": "^7.0.1",
    "graphql": "^16.11.0",
    "graphql-scalars": "^1.25.0",
    "jsdom": "^29.1.1",
    "jsonata": "^2.2.2",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "minimal-password-prompt": "^1.1.0",
    "ms": "^2.1.3",
    "node-cron": "^4.1.0",
    "partial.lenses": "^14.17.0",
    "ramda": "^0.32.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "umzug": "^3.8.3",
    "unified": "^11.0.5",
    "winston": "^3.19.0"
  },
  "overrides": {
    "@feathersjs/koa": {
      "koa-body": "7.0.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@feathersjs/cli": "^5.0.49",
    "@feathersjs/rest-client": "^5.0.49",
    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-codegen/typescript-resolvers": "^5.1.7",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@types/chai": "^4.3.17",
    "@types/chai-as-promised": "^8.0.2",
    "@types/clamscan": "^2.4.1",
    "@types/glob": "^9.0.0",
    "@types/lodash": "^4.17.25",
    "@types/mocha": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/ramda": "^0.32.0",
    "chai": "^4.5.0",
    "chai-as-promised": "^8.0.2",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.38.0",
    "eslint-plugin-chai-friendly": "^1.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "fetch-cookie": "^3.2.0",
    "mocha": "^11.3.0",
    "mockdate": "^3.0.5",
    "nodemon": "^3.1.4",
    "prettier": "^2.8.8",
    "shx": "^0.4.0",
    "tough-cookie": "^6.0.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.62.0"
  }
}
